#!/usr/bin/env bash
set -euo pipefail

URL="${1:-}"
OUTDIR="${2:-/work}"

if [[ -z "$URL" ]]; then
  echo "Usage: ydl-audio <url> [output_dir]" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

# Download the best available audio stream.
# Keep the original codec to avoid any quality loss from re-encoding.
yt-dlp \
  -P "$OUTDIR" \
  -o "%(uploader).80B_%(title).200B_[%(extractor)s-%(id)s].%(ext)s" \
  --restrict-filenames \
  -f "ba/best" \
  --extract-audio \
  --js-runtimes deno:/usr/local/bin/deno \
  --audio-format best \
  --no-mtime \
  --add-metadata \
  --embed-chapters \
  --embed-thumbnail \
  "$URL"
